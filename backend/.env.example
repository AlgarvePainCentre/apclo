NODE_ENV=development
PORT=4000
APP_NAME=APC Backend
API_PREFIX=/api/v1
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,pt,es
AUTH_BEARER_TOKEN=change-me
CSRF_COOKIE_NAME=apc.csrf-token
CSRF_HEADER_NAME=x-csrf-token
DB_CLIENT=none
DB_ORM=native
DB_HOST=localhost
DB_PORT=
DB_NAME=apc
DB_USER=
DB_PASSWORD=
DB_URI=
SWAGGER_SERVER_URL=http://localhost:4000
