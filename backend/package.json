{
  "name": "apc-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scalable Express backend foundation for Algarve Pain Centre",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --watch src/server.js",
    "start": "cross-env NODE_ENV=production node src/server.js",
    "start:development": "cross-env NODE_ENV=development node src/server.js",
    "start:staging": "cross-env NODE_ENV=staging node src/server.js",
    "start:test": "cross-env NODE_ENV=test node src/server.js",
    "test": "cross-env NODE_ENV=test vitest run --coverage",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "docs:check": "node -e \"import('./src/config/openapi.js').then((m) => console.log('OpenAPI title:', m.openapiSpec.info.title))\""
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.0",
    "helmet": "^8.1.0",
    "mongodb": "^6.18.0",
    "mongoose": "^8.16.5",
    "mysql2": "^3.14.3",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "sequelize": "^6.37.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.15",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.1",
    "supertest": "^7.1.1",
    "vitest": "^2.1.1"
  }
}
