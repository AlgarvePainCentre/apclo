{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "algarvepaincentre",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Output of `npm run build:cloudflare`: the Vite build, the prerendered
    // snapshots, and the generated _redirects/_headers.
    "directory": "./dist",
    "binding": "ASSETS",
    // Canonical URLs have no trailing slash: serve /about from about/index.html
    // and redirect /about/ to /about.
    "html_handling": "drop-trailing-slash",
    // Unknown paths fall back to index.html so client-side routes still load.
    "not_found_handling": "single-page-application",
    // Only the contact API runs code; everything else is served as a static asset.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
