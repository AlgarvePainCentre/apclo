# Algarve Pain Centre — environment variables
# Copy to `.env` for local dev, and set the same keys in the Vercel project
# settings for production. Never commit real secrets.

# ── Contact form ────────────────────────────────────────────────────────────
# The contact form (src/pages/contact/Contact.jsx) posts to the Vercel
# serverless function api/contact.js, which verifies hCaptcha and forwards the
# submission to Zoho Forms. All three keys default to hCaptcha/Zoho TEST values
# so previews work out of the box — set REAL values for production.

# hCaptcha PUBLIC site key — rendered in the browser (build-time, Vite).
# Default: hCaptcha's always-pass test key. Get a real one at https://hcaptcha.com
VITE_HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001

# hCaptcha SECRET key — used server-side by api/contact.js to verify the token.
# Default: hCaptcha's always-pass test secret (no real bot protection).
# Set this in Vercel → Project → Settings → Environment Variables (never in the repo).
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000

# Zoho Forms submit URL that receives the lead. Confirm this points at the
# client's live "Contact Us" form before launch.
ZOHO_FORM_ACTION=https://forms.zohopublic.eu/paincentremktgm1/form/1APCContactUs/formperma/VO5_fDW9RtmBVwQ0SjvkM6Pk12IGM2-G-ejswgMV6sY/htmlRecords/submit

# ── Analytics (consent-gated) ───────────────────────────────────────────────
# src/app/AnalyticsManager.jsx loads a tag ONLY when the visitor accepts the
# "Analytics" cookie category. The client's GA4 id (G-GM1C7W4G8M) is baked in as
# the default, so analytics works on deploy with no env config. Override only to
# change the GA4 id, or set VITE_GTM_ID to route through Google Tag Manager.
VITE_GTM_ID=
VITE_GA4_ID=
